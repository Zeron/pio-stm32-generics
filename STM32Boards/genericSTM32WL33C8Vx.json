    "extra_flags": "-DSTM32WL3XX -DSTM32WL",
    "f_cpu": "64000000L",
    "mcu": "stm32wl33c8vx",
    "product_line": "STM32WL3XX",
    "variant": "STM32WL3x/WL33C(8-B-C)Vx(X)"
  },
  "debug": {
